<diagram id="page5" name="6 Rebalancing"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="854"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="5_title" value="Adding or removing a node (consistent hashing)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="5_s0" value="A node joins the ring (first heartbeat) or is decommissioned" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="5_s1" value="Hash ring recomputed: only keys next to the node's virtual positions change owner (about 1/N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="172" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="5_s2" value="POST /admin/rebalance (or decommission): compare every chunk's copies with the ring's choice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="5_s3" value="Copy is on the wrong node?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="388" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="5_x3" value="Leave it where it is" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="399" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="5_s4" value="Copy to the new owner, verify the hash, update Postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="526" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="5_s5" value="Remove the old copy (garbage collection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="634" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="5_s6" value="Report the fraction of copies moved (about 22% for 4 to 5 nodes, against 84% for hash mod N)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="742" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="5_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="5_s0" target="5_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
