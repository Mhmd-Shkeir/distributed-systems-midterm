<mxfile host="app.diagrams.net">
<diagram id="page0" name="1 Architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="0_title" value="Distributed object storage framework: components" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="800" height="36" as="geometry"/></mxCell>
<mxCell id="0_ui" value="Clients: React web UI (/ui), curl, test scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="74" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="0_gw" value="Gateway service (FastAPI): S3-like API, chunking (fixed / content-defined), SHA-256 chunk ids, consistent hash ring (128 virtual nodes), replication with quorums W/R, erasure coding (zfec), dedup + refcounts, search, cluster status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="520" height="150" as="geometry"/></mxCell>
<mxCell id="0_pg" value="Postgres: buckets, objects, chunks + reference counts, chunk locations, nodes, repair log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="0_bg" value="Background jobs inside the gateway: failure detection, repair, scrubber, garbage collection, rebalance" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="66" width="330" height="96" as="geometry"/></mxCell>
<mxCell id="0_n0" value="Storage node 1 (FastAPI)&lt;br&gt;PUT / GET / HEAD / DELETE chunks&lt;br&gt;verify SHA-256 on every read&lt;br&gt;own volume /data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="0_n1" value="Storage node 2 (FastAPI)&lt;br&gt;PUT / GET / HEAD / DELETE chunks&lt;br&gt;verify SHA-256 on every read&lt;br&gt;own volume /data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="470" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="0_n2" value="Storage node 3 (FastAPI)&lt;br&gt;PUT / GET / HEAD / DELETE chunks&lt;br&gt;verify SHA-256 on every read&lt;br&gt;own volume /data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="0_n3" value="Storage node 4 (FastAPI)&lt;br&gt;PUT / GET / HEAD / DELETE chunks&lt;br&gt;verify SHA-256 on every read&lt;br&gt;own volume /data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="470" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="0_env" value="Environment: Docker + Kubernetes, Prometheus, Grafana, Kafka, RabbitMQ, Python venv, GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1020" height="54" as="geometry"/></mxCell>
<mxCell id="0_e0" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="0_ui" target="0_gw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="0_e1" value="metadata (SQL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="0_gw" target="0_pg"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="0_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="0_bg" target="0_gw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="0_e3" value="chunks, shards, heartbeats" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="0_gw" target="0_n0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="0_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="0_gw" target="0_n1"><mxGeometry relative="1" as="geometry"/></mxCell>
