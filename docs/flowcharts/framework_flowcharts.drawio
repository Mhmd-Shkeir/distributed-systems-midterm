<diagram id="page4" name="5 Scrubbing"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="854"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="4_title" value="Background scrubber (integrity)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="4_s0" value="Every 300 s (or POST /admin/scrub) the gateway asks every live node to scrub" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="4_s1" value="Node re-reads every chunk file and recomputes its SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="172" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="4_s2" value="Hash equals the file name?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="4_x2" value="Bit rot: move the file to quarantine and report it as corrupted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="291" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="4_s3" value="Gateway compares the node's file list with the locations recorded in Postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="418" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="4_s4" value="Corrupted and missing copies are forgotten (location rows removed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="526" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="4_s5" value="Repair job rebuilds them from a healthy copy (replica copy, or zfec reconstruction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="634" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="4_s6" value="Log scrub-corrupt, scrub-missing and reconstruct events" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="742" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="4_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="4_s0" target="4_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="4_s1" target="4_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="4_e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4_s2" target="4_x2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="4_e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="4_s2" target="4_s3"><mxGeometry relative="1" as="geometry"/></mxCell>
