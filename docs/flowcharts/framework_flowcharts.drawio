<diagram id="page1" name="2 Write path"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1316"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="1_title" value="Write path: PUT /bucket/key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="1_s0" value="Client: PUT /bucket/key with the object bytes" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="1_s1" value="Gateway: bucket exists? read its durability policy (N, W, R or erasure coding k+m)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="172" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="1_s2" value="Split into chunks: fixed 4 MiB or content-defined (Gear hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="1_s3" value="Chunk id = SHA-256 of the chunk; lock the ids (advisory locks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="388" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="1_s4" value="Chunk already stored?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="496" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="1_x4" value="Deduplicated: only the reference count is increased, nothing is written (then next chunk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="507" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="1_s5" value="Hash ring picks the target nodes: N nodes, or k+m nodes for erasure coding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="634" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="1_s6" value="Replication: PUT the chunk to N nodes.  Erasure coding: zfec encodes k+m shards, one shard per node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="742" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="1_s7" value="Write quorum met? (&gt;= W copies, or &gt;= k+1 shards)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="850" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="1_x7" value="503: too many nodes down; roll back, written pieces go to the garbage-collection queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="861" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="1_s8" value="Postgres (one transaction): chunk rows with reference counts, chunk locations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="988" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="1_s9" value="Insert the object metadata and the ordered list of its chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1096" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="1_s10" value="Return 200 with the ETag (SHA-256 of the object)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1204" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="1_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s0" target="1_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s1" target="1_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s2" target="1_s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s3" target="1_s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1_s4" target="1_x4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e5" value="no: new chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s4" target="1_s5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s5" target="1_s6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s6" target="1_s7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1_s7" target="1_x7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s7" target="1_s8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s8" target="1_s9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="1_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1_s9" target="1_s10"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page2" name="3 Read path"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1130"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="2_title" value="Read path: GET /bucket/key (optional Range)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="2_s0" value="Client: GET /bucket/key, optionally with a Range header" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="2_s1" value="Gateway loads the manifest from Postgres: ordered chunks, locations, node health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="172" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="2_s2" value="Select the chunks that overlap the requested byte range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="2_s3" value="Chunk replicated or erasure coded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="388" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="2_x3" value="Fetch k shards from live nodes (data shards first), verify each shard hash, decode with zfec if a data shard is missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="399" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="2_s4" value="Fetch the chunk from one healthy replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="526" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="2_s5" value="Read quorum met? (R-1 other replicas confirm with HEAD)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="634" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="2_x5" value="503 read quorum not met (header X-DFS-Consistency: any allows a single-replica read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="645" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="2_s6" value="SHA-256 of the chunk equals its id?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="772" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="2_x6" value="Try the next replica or shard; when none is left return 502" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="783" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="2_s7" value="Concatenate the chunks and cut the requested range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="910" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="2_s8" value="Return 200 (or 206 with Content-Range)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1018" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="2_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s0" target="2_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s1" target="2_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s2" target="2_s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e3" value="erasure coded" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="2_s3" target="2_x3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e4" value="replicated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s3" target="2_s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s4" target="2_s5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="2_s5" target="2_x5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s5" target="2_s6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="2_s6" target="2_x6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s6" target="2_s7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="2_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="2_s7" target="2_s8"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page3" name="4 Failure and repair"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="3_title" value="Failure detection and automatic repair" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="3_s0" value="Every 5 s each node sends a heartbeat (id, free space, chunk count)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="3_s1" value="Gateway stores last_seen in Postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="172" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="3_s2" value="Heartbeat missing for 15 s?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="3_x2" value="Node is alive: nothing to do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="291" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="3_s3" value="Node marked FAILED (shown by /nodes, the UI and the repair log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="418" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="3_s4" value="Repair job (every 10 s): find chunks with fewer healthy copies or shards than required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="526" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="3_s5" value="Chunk replicated or erasure coded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="634" width="360" height="92" as="geometry"/></mxCell>
<mxCell id="3_x5" value="Read k surviving shards, decode with zfec, regenerate the lost shard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="645" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="3_s6" value="Copy a healthy replica to a remaining node chosen by the hash ring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="772" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="3_s7" value="Update locations in Postgres; queue the failed node's old copies for garbage collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="880" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="3_s8" value="Log a repair-job entry: chunks rebuilt, bytes read and written" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="988" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="3_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="3_s0" target="3_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
